{
  "name": "unitsml",
  "version": "0.1.0",
  "description": "UnitsML in TypeScript: parse and render UnitsML unit expressions natively (PARG artifact runtime, no Opal)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "replay": "node scripts/replay-oracle.ts",
    "replay:conversions": "node scripts/replay-conversions.ts",
    "prepare": "npm run build",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "asciiunits": "git+https://github.com/suleman-uzair/asciiunits-ts.git#521c0bd6dacdca31febc59b9775144d1511907b4",
    "unitsdb": "git+https://github.com/suleman-uzair/unitsdb-ts.git#22d026b81e80a15ad5b3fa253cfcf23407f18a13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitsml/unitsml-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "engines": {
    "node": ">=24"
  }
}

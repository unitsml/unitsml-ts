{
  "name": "unitsml",
  "version": "0.1.0",
  "description": "UnitsML in TypeScript: parse and render UnitsML unit expressions natively (PARG artifact runtime, no Opal)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "replay": "node scripts/replay-oracle.ts"
  },
  "dependencies": {
    "asciiunits": "github:unitsml/asciiunits-ts",
    "unitsdb": "github:unitsml/unitsdb-ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitsml/unitsml-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "engines": {
    "node": ">=24"
  }
}

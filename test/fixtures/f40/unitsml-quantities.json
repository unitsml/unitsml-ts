 "source_semantics_findings": [
  "Quantity#== compares raw value and dimension vector only: 10 kV * 5 A == 50 W is true (upstream quantity_spec asserts it) and 50 kV*A == 50000 W is false",
  "Quantity.new(value: 3, unit: nil) reports dimension_id nil although the source comment says \"1\" for pure numbers",
  "Quantity.new(value: 1, unit_expression: \"1\") raises untyped NoMethodError"
 ]
}
